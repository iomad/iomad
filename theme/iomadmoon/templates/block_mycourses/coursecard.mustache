{{!
    @template core_course/coursecard

    This template renders the a card for the course cards.

    Example context (json):
    {
        "courses": [
            {
                "name": "Assignment due 1",
                "viewurl": "https://moodlesite/course/view.php?id=2",
                "courseimage": "https://moodlesite/pluginfile/123/course/overviewfiles/123.jpg",
                "fullname": "course 3",
                "hasprogress": true,
                "progress": 10,
                "visible": true
            }
        ]
    }
}}
<div class="rui-course-card  rui-course-card--cat" role="listitem"
    data-region="course-content"
    data-course-id="{{{id}}}">
    <a href="{{url}}" class="text-decoration-none" tabindex="-1">
        <figure class="rui-course-card-img-top" style='background-image: url("{{{image}}}");'>
            <span class="sr-only">{{fullname}}</span>
        </figure>
    </a>
    <div class="rui-course-card-body course-info-container" id="course-info-container-{{id}}-{{uniqid}}">
        <div class="d-flex align-items-start">
            <div class="w-100">
                <h3 class="rui-course-card-title mb-0 w-100">
                    <a href="{{url}}" class="aalink fullname mr-2 mb-1">
                        {{> core_course/favouriteicon }}
                        <span class="sr-only">
                            {{#str}}aria:coursename, core_course{{/str}}
                        </span>
                        {{{fullname}}}
                    </a>
                </h3>
            </div>
        </div>
    </div>
    <div class="rui-course-card-progress-bar">{{#hasprogress}}{{> block_mycourses/progress-bar}}{{/hasprogress}}</div>
</div>
