{{!
    @template local_designer/prerequisites

    Displays the prerequisites courses

    Example context (json):
    {
        "sectiondesigntextcolor": "color: #fff",
        "sectionheaderstyle": "min-height:100px;",
		"prerequisitestitle": "Prerequisites",
		"groupname": "Group 01"
    }
}}
<div class="pre-course-block" id="pre-course">
	<div class="container-fluid">
		<div class="course-section-header section-header-content {{#prerequisitecollapse}}collapsed{{/prerequisitecollapse}} {{coursetype.classes}}"
		id="section-head-precourse"
		{{#prerequisitecollapse}} data-toggle="collapse" {{/prerequisitecollapse}}
		data-target="#section-content-precourse"
		aria-expanded="false"
		aria-controls="section-head-precourse"
		role="contentinfo"
		data-for="section_title"
		{{coursetype.attributes}}
		>
			{{#prerequisitecollapse}}
			<span class="section-collapse-icon" style="{{{sectiondesigntextcolor}}}"></span>
			{{/prerequisitecollapse}}

			<div class="prerequisite-block-info">
				<p> {{{prerequisiteinfo}}}</p>
			</div>
			{{#prerequisitestitle}}
			<div class="section-head-text">
				<a href="{{presectionhead}}#pre-course">  <h2>{{prerequisitestitle}}</h2> </a>
			</div>
			{{/prerequisitestitle}}
		</div>
		<div class="content {{#prerequisitecollapse}}collapse{{/prerequisitecollapse}}show"
		id="section-content-precourse"
		aria-labelledby="section-head-precourse"
		{{#sectionaccordion}}
		data-parent="#section-course-accordion"
		{{/sectionaccordion}}
		role="contentinfo"
		{{coursetype.content.attributes}}
		>
			<p>{{#str}} prerequisitesdesc, format_designer{{/str}}</p>
			<div class="course-element">
				<div class="card-deck dashboard-card-deck" data-element="0">
					{{#nongroupcourseinfo}}
					<div class="card dashboard-card" data-rel="pre_course">
						<a href="{{viewurl}}" {{#prerequisitesnewtab}} target="_blank" {{/prerequisitesnewtab}}>
							<div class="card-img dashboard-card-img" style="background-image: url({{courseimage}})">
							</div>
						</a>
						<div class="block-element">
							<input type="hidden" name="info_{{courseid}}" value="{{coursename}}" id="prerequisite_item_{{courseid}}">
						</div>
						<div class="card-body">
							<div class="d-flex align-items-start">
								<div class="text-truncate">
									<div class="text-muted muted d-flex mb-1 flex-wrap">
										<a href="{{viewurl}}" class="aalink categoryname" {{#prerequisitesnewtab}} target="_blank" {{/prerequisitesnewtab}}>
											<span class="modulename text-truncate">{{{fullname}}}</span>
										</a>
									</div>
									<span class="multiline">{{{coursecategory}}}</span>
								</div>
							</div>
						</div>
						<div class="card-footer dashboard-card-footer">
							{{#hasprogress}}
								<div class="progress bg-white border">
									<div class="progress-bar bar" role="progressbar" aria-valuenow="{{progress}}" style="width: {{progress}}%" aria-valuemin="0" aria-valuemax="100"></div>
								</div>
								<div class="small">
									<strong>{{progress}}</strong>% {{#str}} strcompleted, format_designer{{/str}}
								</div>
							{{/hasprogress}}
						</div>
					</div>
					{{/nongroupcourseinfo}}
				</div>
			</div>
			{{#groupcourseinfo}}
			<div class="course-element">
				{{#groupname}}
					<h2> {{groupname}}</h2>
				{{/groupname}}
				{{#groupintro}} {{{groupintro}}} {{/groupintro}}
				<div class="card-deck dashboard-card-deck" data-element="{{groupid}}">
					{{#hascourse}}
						{{#courses}}
						<div class="card dashboard-card" data-rel="group_{{groupname}}">
							<a href="{{viewurl}}" {{#prerequisitesnewtab}} target="_blank" {{/prerequisitesnewtab}}>
								<div class="card-img dashboard-card-img" style="background-image: url({{courseimage}})">
								</div>
							</a>
							<div class="block-element">
								<input type="hidden" name="info_{{courseid}}" value="{{coursename}}" id="prerequisite_item_{{courseid}}">
							</div>
							<div class="card-body">
								<div class="d-flex align-items-start">
									<div class="text-truncate">
										<div class="text-muted muted d-flex mb-1 flex-wrap">
											<a href="{{viewurl}}" class="aalink categoryname" {{#prerequisitesnewtab}} target="_blank" {{/prerequisitesnewtab}}>
												<span class="modulename text-truncate">{{fullname}}</span>
											</a>
										</div>
										<span class="multiline">{{coursecategory}}</span>
									</div>
								</div>
							</div>
							<div class="card-footer dashboard-card-footer">
								{{#hasprogress}}
									<div class="progress bg-white border">
										<div class="progress-bar bar" role="progressbar" aria-valuenow="{{progress}}" style="width: {{progress}}%" aria-valuemin="0" aria-valuemax="100"></div>
									</div>
									<div class="small">
										<strong>{{progress}}</strong>% {{#str}} strcompleted, format_designer{{/str}}
									</div>
								{{/hasprogress}}
							</div>
						</div>
						{{/courses}}
					{{/hascourse}}
					{{^hascourse}}
						<p class="no-course-group"> <b> {{#str}} nocourses, format_designer {{/str}} </b> </p>
					{{/hascourse}}
				</div>
			</div>
			{{/groupcourseinfo}}
		</div>
	</div>
</div>