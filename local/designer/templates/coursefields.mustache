{{!
    @template local_designer/coursefields.

    Template for the form coursefields template.

    Example context (json):
    {
        "coursefieldsavailable": true
    }
}}
<!-- Course info listing -->
{{#coursefieldsavailable}}
<div class="coursefields">
    <ul class="coursefield-list coursefield-wrapper">
        {{#coursefields}}
        <li class="coursefield-item designer-coursefield coursefield-{{shortname}}">
            <div class="coursefield-icon {{^icon}} default-icon {{/icon}}">
                {{#icon}}{{{icon}}}{{/icon}}
                {{^icon}}{{#pix}} i/marker, core {{/pix}} {{/icon}}
            </div>
            <div class="coursefield-shortname">
                <span>{{{value}}}</span>
            </div>
        </li>
        {{/coursefields}}
    </ul>
</div>
{{/coursefieldsavailable}}
{{#headermetadata}}
<div class="coursefields timemanage-block">
    <ul class="coursefield-list coursefield-wrapper">
        <!-- Default course info as fields. -->
        {{#enrolmentstartdate}}
        <li class="coursefield-item designer-coursefield course-start-date">
            <!-- <div class="course-start-date"> -->
                <div class="coursefield-icon {{^icon}} default-icon {{/icon}}">
                    <i class="icon fa fa-calendar"></i>
                </div>
                <div class="coursefield-shortname">
                    <span>{{#str}} coursestartdate, format_designer {{/str}}: {{#userdate}} {{enrolmentstartdate}}, {{#str}} strftimedate {{/str}} {{/userdate}}</span>
                </div>
            <!-- </div> -->
        </li>
        {{/enrolmentstartdate}}

        {{#courseduedate}}
        <li class="coursefield-item designer-coursefield course-due-date">
            <!-- <div class="course-due-date"> -->
                <div class="coursefield-icon {{^icon}} default-icon {{/icon}}">
                    <i class="icon fa fa-clock-o"></i>
                </div>
                <div class="coursefield-shortname">
                    <span>{{#str}} courseduedate, format_designer {{/str}}: {{#userdate}} {{courseduedate}}, {{#str}} strftimedate {{/str}} {{/userdate}}</span>
                </div>
            <!-- </div> -->
        </li>
        {{/courseduedate}}

        {{#showcompletiondate}}
        <li class="coursefield-item designer-coursefield course-completion-date">
            <!-- <div class="course-completion-date"> -->
                <div class="coursefield-icon {{^icon}} default-icon {{/icon}}">
                    <i class="icon fa fa-flag-checkered"></i>
                </div>
                {{#completiondate}}
                <div class="coursefield-shortname">
                    <span>{{#str}} coursecompletiondate, format_designer {{/str}}: {{#userdate}} {{completiondate}}, {{#str}} strftimedate {{/str}} {{/userdate}}</span>
                </div>
                {{/completiondate}}
                {{^completiondate}}
                <div class="coursefield-shortname">
                        <span>{{#str}} coursecompletiondate, format_designer {{/str}} -/-</span>
                </div>
                {{/completiondate}}
            <!-- </div> -->
        </li>
        {{/showcompletiondate}}

        {{#showindicatorstatus}}
             <li class="coursefield-item designer-coursefield course-completion-date">
                {{#indicatorstatus}}
                <div class="course-indicator-status">
                    <p> {{#str}} courseindicator, format_designer{{/str}} <span class="status-{{indicatorclass}}"> {{indicatorstatus}} </span> </p>
                </div>
                {{/indicatorstatus}}
             </li>
        {{/showindicatorstatus}}

        {{#enrolmentenddate}}
        <li class="coursefield-item designer-coursefield course-expire-date">
            <!-- <div class="course-expire-date"> -->
                <div class="coursefield-icon {{^icon}} default-icon {{/icon}}">
                    <i class="icon fa fa-sign-out"></i>
                </div>
                {{#enrolmentenddate}}
                <div class="coursefield-shortname">
                    <span>{{#str}} courseexpirationdate, format_designer {{/str}} {{#userdate}} {{enrolmentenddate}}, {{#str}} strftimedate {{/str}} {{/userdate}}</span>
                </div>
                {{/enrolmentenddate}}

                {{^enrolmentenddate}}
                <div class="coursefield-shortname">
                    <span>{{#str}} courseexpirationdate, format_designer {{/str}} -/-</span>
                </div>
                {{/enrolmentenddate}}
            <!-- </div> -->
        </li>
        {{/enrolmentenddate}}
    </ul>
</div>
{{/headermetadata}}
<!-- End of Course info listing -->

