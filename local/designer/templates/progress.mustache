{{!
    @template local_designer/progressdonut.

    Template for the form progress donut template.

    Example context (json):
    {
        "title": "Course full name"
    }
}}
<!-- Progress Bar -->
{{#progressbar}}
    {{^sectionprogresscompletion}}
    <div class="progress-bar{{#progress}} progress-bg-success{{/progress}}{{^progress}} progress-not-started{{/progress}}">
        <div class="progress {{#courseprogresscompletion}} completed {{/courseprogresscompletion}}">
            <div class="progress-bar{{#progress}} progress-bg-success{{/progress}}{{^progress}} progress-not-started{{/progress}}" role="progressbar" {{#progress}}style= "width: {{progress}}%"{{/progress}} aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100">
                <span class="percentage">{{progress}}%</span>
            </div>
        </div>
    </div>
    {{/sectionprogresscompletion}}
    {{#sectionprogresscompletion}}
        <div class="section-progress-completed">
            <span class="badge badge-completion badge-success"><span><i class="fa fa-check"></i> {{#str}}sectioncompleted, format_designer{{/str}}</span></span>
        </div>
    {{/sectionprogresscompletion}}
{{/progressbar}}
<!-- End of Progress Bar -->

<!-- Progress donut -->
{{#progressdonut}}
    <div class="progress-donut {{#courseprogresscompletion}}course-completed{{/courseprogresscompletion}}{{#sectionprogresscompletion}}section-completed{{/sectionprogresscompletion}}">
        <div class="progress" data-value="{{{progress}}}">
            <!-- Progress Left -->
            <span class="progress-left">
                <span class="progress-bar" style="transform: rotate({{deg2}}deg);"></span>
            </span>
            <!-- Progress Right -->
            <span class="progress-right">
                <span class="progress-bar" style="transform: rotate({{deg1}}deg);"></span>
            </span>
            <!-- Progress Value -->
            <div class="progress-value w-100 h-100 rounded-circle d-flex align-items-center justify-content-center {{#courseprogresscompletion}}completed{{/courseprogresscompletion}} {{#sectionprogresscompletion}}completed{{/sectionprogresscompletion}} ">
                {{#issection}}
                    <div class="h2 font-weight-bold" {{#progresstextcolor}} style="color:{{progresstextcolor}}"{{/progresstextcolor}}>{{{progress}}}%</div>
                {{/issection}}

                {{^issection}}
                    {{^courseprogresscompletion}}
                        <div class="h2 font-weight-bold">{{{progress}}}%</div>
                    {{/courseprogresscompletion}}
                    {{#courseprogresscompletion}}
                        <div class="h2 font-weight-bold">{{{donutshowprogress}}}</div>
                    {{/courseprogresscompletion}}
                {{/issection}}
            </div>
        </div>
    </div>
{{/progressdonut}}
<!-- End of Progress donut -->
